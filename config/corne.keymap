#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

// QMK TT(n): hold = momentánea, doble tap = capa fija
#define TT1 &ht_tt_1 1 0
#define TT2 &ht_tt_2 2 0
#define TT3 &ht_tt_3 3 0

/ {
    // Hold = &mo. Doble tap = &tog. Equivalente a QMK TT().
    behaviors {
        td_tog_1: tap_dance_toggle_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&none>, <&tog 1>;
        };

        td_tog_2: tap_dance_toggle_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&none>, <&tog 2>;
        };

        td_tog_3: tap_dance_toggle_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&none>, <&tog 3>;
        };

        ht_tt_1: hold_tap_toggle_1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&td_tog_1>;
        };

        ht_tt_2: hold_tap_toggle_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&td_tog_2>;
        };

        ht_tt_3: hold_tap_toggle_3 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&td_tog_3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U  &kp I     &kp O    &kp P     &kp BSPC
&kp TAB     &kp A  &kp S  &kp D  &kp F  &kp G        &kp H  &kp J  &kp K     &kp L    &kp SEMI  &kp SQT
&kp LSHFT   &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH  &kp RCTRL
                              &kp LGUI  TT1  &kp SPACE    &kp RET  TT2  &kp RALT
            >;
        };

        layer_1 {
            bindings = <
&kp ESC     &kp AT   &kp BSLH  &kp DLLR  &kp HASH  &kp GRAVE    &kp KP_SLASH  &kp N7  &kp N8  &kp N9     &kp MINUS  &kp BSPC
&kp CAPS    &none    &kp CARET &kp AMPS  &kp LPAR  &kp RPAR     &kp KP_MULTIPLY &kp N4  &kp N5  &kp N6     &kp EQUAL  &kp KP_NUM
&kp LSHFT   &none    &kp EXCL  &kp FSLH  &kp LBRC  &kp RBRC     &kp KP_DOT    &kp N1  &kp N2  &kp N3     &kp PRCNT  &none
                                        &kp LGUI  &trans  &kp SPACE    &kp RET  TT3  &kp N0
            >;
        };

        layer_2 {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6      &none  &none  &none  &none  &kp PSCRN  &kp DEL
&kp F7   &kp F8   &kp F9   &kp F10  &kp F11  &kp F12     &none  &kp HOME &kp UP &kp END  &none  &kp PAUSE_BREAK
&kp LSHFT &none   &none    &none    &none    &none       &none  &kp LEFT &kp DOWN &kp RIGHT &none  &none
                              &kp LGUI  TT3  &kp SPACE    &kp RET  &trans  &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&bootloader  &none  &none  &none  &none  &none        &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &kp C_PP  &kp C_STOP  &none
&rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &none  &none  &kp C_PREV  &kp C_NEXT  &none  &none  &none  &none
&rgb_ug RGB_EFF  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &none  &none  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                              &kp LGUI  &trans  &kp SPACE    &kp RET  &trans  &kp RALT
            >;
        };
    };
};
